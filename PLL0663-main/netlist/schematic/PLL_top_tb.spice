**.subckt PLL_top_tb
Vref clk_ref gd dc 0 ac 0 pulse(0 {Vph} {T/2} 10n 10n {T/2} {T})
Vp Vp gd dc {Vp}
Vph Vph gd dc {Vph}
C1 out gd 20p
V8 d4 gd 0
V9 d5 gd 0
V11 d0 gd 1.2
V10 d1 gd 1.2
V12 d2 gd 0
V7 d3 gd 0
V5 a1 gd 1.2
V6 a0 gd 1.2
V13 a2 gd 1.2
xTOP gd vp out vph clk_ref rst gd gd clk_in debug_out vout gd gd gd TOP
Vp1 rst gd dc {Vp} ac 0 PULSE({Vp} 0 2u 1n 1n 1 2)
Vp2 gd GND dc 0
x1 net1 gd RC_filter
* noconn #net7
* noconn #net6
* noconn #net5
