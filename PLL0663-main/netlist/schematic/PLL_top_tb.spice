* Operating Point Analysis



write PLL_top_tb.raw
set appendwrite
save v(gd) v(vp) v(rst) v(out) v(xPLL.cvco) v(xPLL.cref) v(xPLL.UP) v(xPLL.DOWN) v(xPLL.vout) v(xPLL.vco_out_prebuff) v(xPLL.vout_aftRC) v(xPLL.vco_out_buffered) v(xPLL.out_PLL_divided) v(xPLL.pre_LS) v(xPLL.aft_LS) i(vp) i(vph)
tran 0.1n 3m
meas tran t1 WHEN v(out)=1.65 RISE=1 FROM=0.7m
meas tran t2 WHEN v(out)=1.65 RISE=2 FROM=0.7m
meas tran period PARAM='t2-t1'
meas tran freq PARAM='1/period'

write PLL_prad.raw
.endc


